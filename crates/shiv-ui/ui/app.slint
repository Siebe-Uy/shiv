// Application shell: sidebar navigation over five screens.

import { Theme } from "theme.slint";
import { BrowsePage, BrowseState, ModRow, LoadState, InstallState, DownloadPicker, DownloadRow, ModDetail, GalleryThumb, HeroOption, ImageState } from "browse.slint";
import { InstalledPage, InstalledState, InstalledRow } from "installed.slint";
import { LaunchPanel, LaunchDialog, LaunchState, FindingRow } from "launch.slint";
import { RepairPage, RepairDialog, RepairState, RepairRow, RepairTone } from "repair.slint";
import { CrosshairPage, CrosshairState, CrosshairValues, CrosshairField } from "crosshair.slint";
import { PerformancePage, PerfState, PerfTier, PerfRow, PerfControl, PerfEditor, PerfChange } from "performance.slint";

export { BrowseState, ModRow, LoadState, InstallState, DownloadRow, ModDetail, GalleryThumb, HeroOption, ImageState, InstalledState, InstalledRow, LaunchState, FindingRow, RepairState, RepairRow, RepairTone, CrosshairState, CrosshairValues, CrosshairField, PerfState, PerfTier, PerfRow, PerfControl, PerfEditor, PerfChange }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    // Short count shown at the right edge (e.g. fixable mods); "" for none.
    in property <string> badge;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    height: Theme.control-h;
    border-radius: Theme.radius;
    background: root.active ? Theme.raised : (ta.has-hover ? Theme.hover : transparent);

    Rectangle {
        x: 0px;
        y: Theme.s1;
        width: 2px;
        height: parent.height - 2 * Theme.s1;
        background: Theme.accent;
        visible: root.active;
    }

    Text {
        x: Theme.s2;
        width: parent.width - 3 * Theme.s2;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.text-md;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }

    if root.badge != "": Text {
        x: parent.width - Theme.s2 - self.width;
        height: parent.height;
        text: root.badge;
        color: Theme.accent;
        font-size: Theme.text-sm;
        font-weight: 600;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component App inherits Window {
    title: "Shiv";
    icon: @image-url("assets/shiv-icon-64.png");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 840px;
    min-height: 520px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.text-md;

    in-out property <int> screen: 0;
    property <[string]> screens: ["Browse", "Installed", "Crosshair", "Performance", "Repair"];

    // Re-read the addons folder whenever the Installed screen is shown.
    changed screen => {
        if (root.screen == 0) {
            BrowseState.shown();
        }
        if (root.screen == 1) {
            InstalledState.refresh();
        }
        if (root.screen == 2) {
            CrosshairState.shown();
        }
        if (root.screen == 3) {
            PerfState.shown();
        } else {
            PerfState.hidden();
        }
        if (root.screen == 4) {
            RepairState.shown();
        }
        LaunchState.refresh();
    }

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: Theme.s2;
                spacing: Theme.s1;

                Rectangle {
                    height: Theme.s4 * 2;

                    Image {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: Theme.s4 + Theme.s1;
                        source: @image-url("assets/shiv-wordmark.svg");
                        image-fit: contain;
                    }
                }

                for name[i] in root.screens: NavItem {
                    label: name;
                    active: root.screen == i;
                    badge: i == 4 && RepairState.fixable-count > 0 ? RepairState.fixable-count : "";
                    clicked => {
                        BrowseState.return-screen = -1;
                        root.screen = i;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                LaunchPanel { }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            // Kept alive while hidden so search text and scroll position survive navigation.
            BrowsePage {
                width: parent.width;
                height: parent.height;
                visible: root.screen == 0;
            }

            InstalledPage {
                width: parent.width;
                height: parent.height;
                visible: root.screen == 1;
            }

            CrosshairPage {
                width: parent.width;
                height: parent.height;
                visible: root.screen == 2;
            }

            RepairPage {
                width: parent.width;
                height: parent.height;
                visible: root.screen == 4;
            }

            PerformancePage {
                width: parent.width;
                height: parent.height;
                visible: root.screen == 3;
            }
        }
    }

    if RepairState.confirm != 0: RepairDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }

    if BrowseState.picker-open: DownloadPicker {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }

    if LaunchState.dialog-open: LaunchDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
}
