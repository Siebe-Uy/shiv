// Design tokens. One accent, one typeface, an 8 px spacing grid.
// Dark neutral surfaces, no gradients, no glow, no decorative shadows.

export global Theme {
    // Brass Noir (dark) tokens, from style/tokens.json.
    // Surfaces, darkest to lightest.
    out property <color> bg-sunken: #0b0a09;
    out property <color> bg: #121110;
    out property <color> sidebar: #0b0a09;
    out property <color> raised: #1e1b17;
    out property <color> hover: #2a2620;
    out property <color> border: #3a352d;
    out property <color> border-strong: #4e483d;

    // Text.
    out property <color> text: #ede6d6;
    out property <color> text-muted: #a69f90;
    out property <color> text-faint: #a69f90;

    // The single accent (brass) and the text that sits on it.
    out property <color> accent: #c9a44c;
    out property <color> accent-hover: #d9b862;
    out property <color> on-accent: #121110;

    // Status.
    out property <color> success: #6fbf9f;
    out property <color> danger: #e5636b;

    // Typography. One family; sizes are free, spacing is not.
    out property <string> font: "Adwaita Sans";
    out property <length> text-sm: 12px;
    out property <length> text-md: 14px;
    out property <length> text-lg: 15px;
    out property <length> text-xl: 20px;

    // Spacing grid.
    out property <length> s1: 8px;
    out property <length> s2: 16px;
    out property <length> s3: 24px;
    out property <length> s4: 32px;
    out property <length> control-h: 32px;
    out property <length> radius: 4px;
    out property <length> radius-md: 8px;
}
