// Installed: mods found in the addons folder, with enable toggle and uninstall.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextButton, Switch, ProgressBar } from "widgets.slint";
import { LoadState, CenteredMessage } from "browse.slint";

export struct InstalledRow {
    id: string,
    name: string,
    detail: string,
    // Subtle label for VPKs Shiv did not install; empty for managed mods.
    tag: string,
    thumb: image,
    has-thumb: bool,
    enabled: bool,
    managed: bool,
    // The catalog has a newer version than the installed one.
    update: bool,
    // An install or update of this mod is downloading or installing.
    transferring: bool,
    // 0..1, negative when the size is unknown.
    progress: float,
    transfer-text: string,
}

export global InstalledState {
    in property <[InstalledRow]> rows;
    in property <LoadState> load-state: LoadState.loading;
    in property <string> error-text;
    in property <string> banner-text;
    in property <string> summary;
    // Deadlock is running: toggling and uninstalling are refused.
    in property <bool> game-running;
    // A re-read or an action is in flight on a worker thread.
    in property <bool> busy;
    // The repair package no longer matches the mods but still loads.
    in property <bool> repair-stale;
    // Row waiting for uninstall confirmation, "" when none.
    in-out property <string> confirm-id;

    callback refresh();
    callback toggle(string);
    callback uninstall(string);
    // Download and install the mod's newer version.
    callback update(string);
    callback dismiss-banner();
    // Show the Repair screen.
    callback open-repair();
    // Open the mod's catalog detail page (managed mods only).
    callback open-detail(string);
}

component InstalledRowView inherits Rectangle {
    in property <InstalledRow> item;
    in property <bool> locked;
    // Files are being replaced: no toggling or uninstalling meanwhile.
    property <bool> frozen: root.locked || root.item.transferring;

    height: 90px + 2 * Theme.s1 + 1px;
    background: hover-area.has-hover ? Theme.raised : transparent;

    hover-area := TouchArea {
        mouse-cursor: root.item.managed ? pointer : default;
        clicked => {
            if (root.item.managed) {
                InstalledState.open-detail(root.item.id);
            }
        }
    }

    HorizontalLayout {
        padding-top: Theme.s1;
        padding-bottom: Theme.s1 + 1px;
        padding-left: Theme.s1;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        Rectangle {
            width: 160px;
            height: 90px;
            border-radius: Theme.radius;
            clip: true;
            background: Theme.hover;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.item.thumb;
                image-fit: cover;
                visible: root.item.has-thumb;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.s1;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: root.item.enabled ? Theme.text : Theme.text-muted;
                font-size: Theme.text-lg;
                font-weight: 600;
                overflow: elide;
            }
            if root.item.detail != "": Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                overflow: elide;
            }
            if root.item.tag != "": Text {
                text: root.item.tag;
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }

        VerticalLayout {
            width: 200px;
            alignment: center;
            spacing: Theme.s1;

            if InstalledState.confirm-id != root.item.id: HorizontalLayout {
                spacing: Theme.s1;
                Text {
                    text: root.item.enabled ? "Enabled" : "Disabled";
                    color: Theme.text-muted;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                }
                Switch {
                    label: "Enable " + root.item.name;
                    checked: root.item.enabled;
                    disabled: root.frozen;
                    toggled => { InstalledState.toggle(root.item.id); }
                }
            }
            if InstalledState.confirm-id != root.item.id: HorizontalLayout {
                alignment: end;
                spacing: Theme.s1;
                if root.item.transferring: VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    ProgressBar { progress: root.item.progress; }
                    Text {
                        text: root.item.transfer-text;
                        color: Theme.text-muted;
                        font-size: Theme.text-sm;
                        overflow: elide;
                    }
                }
                if root.item.update && !root.item.transferring: Button {
                    text: "Update";
                    primary: true;
                    disabled: root.frozen;
                    clicked => { InstalledState.update(root.item.id); }
                }
                TextButton {
                    text: "Uninstall";
                    disabled: root.frozen;
                    clicked => { InstalledState.confirm-id = root.item.id; }
                }
            }

            if InstalledState.confirm-id == root.item.id: Text {
                text: "Delete this mod's files?";
                color: Theme.text;
                font-size: Theme.text-md;
                horizontal-alignment: right;
            }
            if InstalledState.confirm-id == root.item.id: HorizontalLayout {
                spacing: Theme.s1;
                alignment: end;
                TextButton {
                    text: "Keep";
                    clicked => { InstalledState.confirm-id = ""; }
                }
                Button {
                    text: "Delete";
                    danger: true;
                    disabled: root.frozen;
                    clicked => {
                        InstalledState.uninstall(root.item.id);
                    }
                }
            }
        }
    }

    Rectangle {
        x: Theme.s1;
        y: parent.height - 1px;
        width: parent.width - Theme.s1;
        height: 1px;
        background: Theme.border;
    }
}

export component InstalledPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding: Theme.s3;
        padding-bottom: 0px;
        spacing: Theme.s2;

        HorizontalLayout {
            spacing: Theme.s2;
            Text {
                text: "Installed";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                horizontal-stretch: 1;
            }
            Text {
                text: InstalledState.summary;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                vertical-alignment: center;
            }
            TextButton {
                text: "Refresh";
                clicked => { InstalledState.refresh(); }
            }
        }

        if InstalledState.game-running: Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.raised;
            HorizontalLayout {
                padding: Theme.s1;
                padding-left: Theme.s2;
                padding-right: Theme.s2;
                Text {
                    text: "Deadlock is running. Close it to enable, disable or uninstall mods, then press Refresh.";
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if InstalledState.repair-stale: Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.accent;
            background: Theme.raised;
            HorizontalLayout {
                padding-left: Theme.s2;
                padding-right: Theme.s1;
                spacing: Theme.s2;
                Text {
                    text: "Repair package out of date: your mods changed since the last repair, but the old repair package still loads and may patch files that changed or are gone. Re-apply or remove it on the Repair screen.";
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: "Open Repair";
                    clicked => { InstalledState.open-repair(); }
                }
            }
        }

        if InstalledState.banner-text != "": Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.raised;
            HorizontalLayout {
                padding-left: Theme.s2;
                padding-right: Theme.s1;
                spacing: Theme.s2;
                Text {
                    text: InstalledState.banner-text;
                    color: Theme.text;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: "Dismiss";
                    clicked => { InstalledState.dismiss-banner(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if InstalledState.load-state == LoadState.loading: CenteredMessage {
                title: "Loading installed mods";
            }

            if InstalledState.load-state == LoadState.failed: VerticalLayout {
                alignment: center;
                spacing: Theme.s2;
                CenteredMessage {
                    title: "Couldn't read installed mods";
                    detail: InstalledState.error-text;
                }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: "Retry";
                        primary: true;
                        clicked => { InstalledState.refresh(); }
                    }
                }
            }

            if InstalledState.load-state == LoadState.ready && InstalledState.rows.length == 0: CenteredMessage {
                title: "No mods installed";
                detail: "Mods you install from Browse appear here.";
            }

            ListView {
                visible: InstalledState.load-state == LoadState.ready && InstalledState.rows.length > 0;
                for row in InstalledState.rows: InstalledRowView {
                    item: row;
                    locked: InstalledState.game-running || InstalledState.busy;
                }
            }
        }
    }
}

export global ConflictState {
    in-out property <bool> open;
    in property <string> new-name;
    // Comma-separated names of the enabled mods the new one conflicts with.
    in property <string> old-names;
    in property <string> error-text;
    in property <bool> busy;
    // The dialog came from switching an installed mod on (nothing has changed
    // yet, so it can be cancelled); otherwise from an install that finished.
    in property <bool> enabling;

    callback keep-both();
    callback swap();
    callback cancel();
}

// Modal over the whole window: a new mod replaces the same hero's content as
// mods that are already enabled.
export component ConflictDialog inherits Rectangle {
    background: Theme.bg-sunken.with-alpha(0.75);

    // Swallow clicks on the scrim.
    TouchArea { }

    card := Rectangle {
        width: min(520px, root.width - 2 * Theme.s4);
        height: min(body.preferred-height, root.height - 2 * Theme.s4);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        // The card itself must not pass clicks to the scrim below.
        TouchArea { }

        body := VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;

            Text {
                text: "Another mod for the same hero";
                color: Theme.text;
                font-size: Theme.text-xl;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.new-name + (ConflictState.enabling ? " would change" : " changes") + " the same thing as " + ConflictState.old-names + ", which is already enabled. Only one of them can win in game.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            Text {
                text: ConflictState.enabling ? "Swapping switches the other mod off and this one on. Nothing is deleted." : "Swapping switches the old mod off. Its files stay, so you can turn it back on from Installed.";
                color: Theme.text-muted;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            if ConflictState.error-text != "": Text {
                text: ConflictState.error-text;
                color: Theme.danger;
                font-size: Theme.text-md;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.s1;
                alignment: end;
                if ConflictState.enabling: TextButton {
                    text: "Cancel";
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.cancel(); }
                }
                Button {
                    text: "Enable both";
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.keep-both(); }
                }
                Button {
                    text: ConflictState.enabling ? "Swap" : "Swap for the new one";
                    primary: true;
                    disabled: ConflictState.busy;
                    clicked => { ConflictState.swap(); }
                }
            }
        }
    }
}
