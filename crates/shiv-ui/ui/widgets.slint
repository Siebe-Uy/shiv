// Small custom controls so every surface follows the theme exactly.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    // Destructive action: outlined and labelled in the danger colour.
    in property <bool> danger: false;
    in property <bool> disabled: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (!root.disabled) {
            root.clicked();
        }
    }

    opacity: root.disabled ? 0.4 : 1.0;

    height: Theme.control-h;
    min-width: label.preferred-width + 2 * Theme.s2;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.danger : (ta.has-hover ? Theme.accent : Theme.border);
    background: root.primary
        ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover ? Theme.hover : transparent);

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
        font-size: Theme.text-md;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Text-only action, for secondary actions that sit inside dense rows.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (!root.disabled) {
            root.clicked();
        }
    }

    opacity: root.disabled ? 0.4 : 1.0;

    height: Theme.control-h;
    min-width: label.preferred-width + Theme.s2;

    label := Text {
        text: root.text;
        color: ta.has-hover ? Theme.text : Theme.text-muted;
        font-size: Theme.text-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    callback edited(string);

    height: Theme.control-h;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.raised;

    hint := Text {
        x: Theme.s2;
        width: parent.width - 2 * Theme.s2;
        height: parent.height;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.text-faint;
        font-size: Theme.text-md;
        vertical-alignment: center;
    }

    input := TextInput {
        x: Theme.s2;
        width: parent.width - 2 * Theme.s2;
        height: parent.height;
        single-line: true;
        color: Theme.text;
        font-size: Theme.text-md;
        vertical-alignment: center;
        selection-background-color: Theme.accent.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        accessible-label: root.placeholder;
        edited => { root.edited(self.text); }
    }
}

export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    in property <string> label;
    callback selected(int);

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.options[root.current-index];

    height: Theme.control-h;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: ta.has-hover ? Theme.hover : Theme.raised;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    Text {
        x: Theme.s2;
        width: parent.width - 2 * Theme.s2 - Theme.s2;
        height: parent.height;
        text: root.options[root.current-index];
        color: Theme.text;
        font-size: Theme.text-md;
        vertical-alignment: center;
        overflow: elide;
    }

    // Chevron.
    Path {
        x: parent.width - Theme.s2 - 8px;
        y: (parent.height - 4px) / 2;
        width: 8px;
        height: 4px;
        viewbox-width: 8;
        viewbox-height: 4;
        commands: "M 0 0 L 4 4 L 8 0";
        stroke: Theme.text-muted;
        stroke-width: 1.5px;
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + Theme.s1;
        width: root.width;
        height: min(root.options.length * Theme.control-h + Theme.s2, 320px);

        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;

            ListView {
                x: 1px;
                y: Theme.s1;
                width: parent.width - 2px;
                height: parent.height - Theme.s2;
                for option[i] in root.options: Rectangle {
                    height: Theme.control-h;
                    background: ota.has-hover ? Theme.hover : transparent;
                    Text {
                        x: Theme.s2;
                        width: parent.width - 2 * Theme.s2;
                        height: parent.height;
                        text: option;
                        color: i == root.current-index ? Theme.accent : Theme.text;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ota := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component ProgressBar inherits Rectangle {
    // 0..1; negative means unknown total.
    in property <float> progress;
    height: 4px;
    border-radius: 2px;
    background: Theme.border;
    Rectangle {
        x: 0px;
        width: root.progress < 0 ? 0px : parent.width * clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
    }
}

// On/off switch. Reports a toggle request; the owner flips `checked`.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> disabled: false;
    in property <string> label;
    callback toggled;

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (!root.disabled) {
            root.toggled();
        }
    }

    width: 40px;
    height: 24px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.border-strong;
    opacity: root.disabled ? 0.4 : 1.0;

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: parent.height - 8px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.on-accent : Theme.text;
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Horizontal slider with its label and value above the track. Reports the
// value under the pointer (snapped to `step`); the owner sets `value`.
export component Slider inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 1;
    // The value as shown, e.g. "80%".
    in property <string> value-text;
    in property <bool> disabled: false;
    callback changed(float);

    property <float> fraction: root.maximum > root.minimum
        ? clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
    property <length> thumb: 14px;

    pure function snap(v: float) -> float {
        clamp(round(v / root.step) * root.step, root.minimum, root.maximum)
    }
    function set-from(x: length) {
        if (!root.disabled) {
            root.changed(root.snap(root.minimum + clamp((x - track.x) / track.width, 0, 1) * (root.maximum - root.minimum)));
        }
    }

    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => {
        if (!root.disabled) {
            root.changed(root.snap(root.value + root.step));
        }
    }
    accessible-action-decrement => {
        if (!root.disabled) {
            root.changed(root.snap(root.value - root.step));
        }
    }

    height: 44px;
    opacity: root.disabled ? 0.4 : 1.0;

    Text {
        x: 0px;
        y: 0px;
        height: 20px;
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.text-md;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - self.width;
        y: 0px;
        height: 20px;
        text: root.value-text;
        color: Theme.text;
        font-size: Theme.text-md;
        font-weight: 600;
        vertical-alignment: center;
    }

    track := Rectangle {
        x: root.thumb / 2;
        y: 32px - self.height / 2;
        width: parent.width - root.thumb;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;

        Rectangle {
            x: 0px;
            width: parent.width * root.fraction;
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    Rectangle {
        x: track.x + track.width * root.fraction - self.width / 2;
        y: track.y + track.height / 2 - self.height / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: self.width / 2;
        background: ta.pressed || ta.has-hover ? Theme.accent-hover : Theme.accent;
        border-width: 2px;
        border-color: Theme.bg;
    }

    ta := TouchArea {
        y: 20px;
        height: parent.height - 20px;
        enabled: !root.disabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}
