// Browse: search, sort, category filter and a virtualised list of mods.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, TextButton, SearchField, Dropdown, Switch } from "widgets.slint";
import { BrowseState, LoadState, InstallState, ModRow, DownloadRow, ModDetail, GalleryThumb, ImageState, InstallControls, NsfwTag } from "browse-common.slint";
import { ModDetailPage } from "mod-detail.slint";

export { BrowseState, LoadState, InstallState, ModRow, DownloadRow, ModDetail, GalleryThumb, ImageState }

component ModRowView inherits Rectangle {
    in property <ModRow> item;

    height: 135px + 2 * Theme.s1 + 1px;
    background: hover-area.has-hover ? Theme.raised : transparent;

    // Clicking the row (outside its buttons) opens the mod's detail page.
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-action-default => { BrowseState.open-detail(root.item.id); }

    hover-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { BrowseState.open-detail(root.item.id); }
    }

    HorizontalLayout {
        padding-top: Theme.s1;
        padding-bottom: Theme.s1 + 1px;
        padding-left: Theme.s1;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        Rectangle {
            width: 240px;
            height: 135px;
            border-radius: Theme.radius;
            clip: true;
            background: Theme.hover;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.item.thumb;
                image-fit: cover;
                visible: root.item.has-thumb;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.s1;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Theme.s1;
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-size: Theme.text-lg;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    max-width: self.preferred-width;
                }
                if root.item.nsfw: NsfwTag {
                    y: (parent.height - self.height) / 2;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.item.byline;
                color: Theme.text-muted;
                font-size: Theme.text-md;
                overflow: elide;
            }
            Text {
                text: root.item.stats;
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                overflow: elide;
            }
            if root.item.updated != "": Text {
                text: root.item.updated;
                color: Theme.text-faint;
                font-size: Theme.text-sm;
                overflow: elide;
            }
        }

        InstallControls {
            width: 160px;
            item: root.item;
        }
    }

    Rectangle {
        x: Theme.s1;
        y: parent.height - 1px;
        width: parent.width - Theme.s1;
        height: 1px;
        background: Theme.border;
    }
}

export component CenteredMessage inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    alignment: center;
    spacing: Theme.s1;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.text-lg;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: root.detail;
        visible: root.detail != "";
        color: Theme.text-muted;
        font-size: Theme.text-md;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component BrowsePage inherits Rectangle {
    background: Theme.bg;

    // Hidden, not destroyed, while a detail page is open: search text,
    // filters and scroll position are all still there on Back.
    list-page := Rectangle {
        visible: !BrowseState.detail-open;

        VerticalLayout {
            padding: Theme.s3;
            padding-bottom: 0px;
            spacing: Theme.s2;

            HorizontalLayout {
                Text {
                    text: "Browse";
                    color: Theme.text;
                    font-size: Theme.text-xl;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Theme.s1;
                    padding-right: Theme.s3;
                    Text {
                        horizontal-stretch: 0;
                        text: "Show NSFW";
                        color: Theme.text-muted;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                    }
                    Switch {
                        y: (parent.height - self.height) / 2;
                        label: "Show NSFW";
                        checked: BrowseState.show-nsfw;
                        toggled => { BrowseState.toggle-nsfw(); }
                    }
                }
                Text {
                    text: BrowseState.summary;
                    color: Theme.text-muted;
                    font-size: Theme.text-md;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: Theme.s1;
                SearchField {
                    horizontal-stretch: 1;
                    placeholder: "Search by name, author or description";
                    edited(text) => { BrowseState.search-edited(text); }
                }
                Dropdown {
                    width: 176px;
                    label: "Sort";
                    options: BrowseState.sorts;
                    current-index <=> BrowseState.sort-index;
                    selected(i) => { BrowseState.sort-selected(i); }
                }
                Dropdown {
                    width: 208px;
                    label: "Category";
                    options: BrowseState.categories;
                    current-index <=> BrowseState.category-index;
                    selected(i) => { BrowseState.category-selected(i); }
                }
            }

            if BrowseState.banner-text != "": Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.raised;
                HorizontalLayout {
                    padding-left: Theme.s2;
                    padding-right: Theme.s1;
                    spacing: Theme.s2;
                    Text {
                        text: BrowseState.banner-text;
                        color: Theme.text;
                        font-size: Theme.text-md;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    TextButton {
                        text: "Dismiss";
                        clicked => { BrowseState.dismiss-banner(); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                if BrowseState.load-state == LoadState.loading: CenteredMessage {
                    title: "Loading mods";
                }

                if BrowseState.load-state == LoadState.failed: VerticalLayout {
                    alignment: center;
                    spacing: Theme.s2;
                    CenteredMessage {
                        title: "Couldn't load mods";
                        detail: BrowseState.error-text;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Retry";
                            primary: true;
                            clicked => { BrowseState.retry(); }
                        }
                    }
                }

                if BrowseState.load-state == LoadState.ready && BrowseState.mods.length == 0: CenteredMessage {
                    title: "No mods match";
                    detail: "Try a different search or category.";
                }

                mod-list := ListView {
                    visible: BrowseState.load-state == LoadState.ready && BrowseState.mods.length > 0;
                    content-y <=> BrowseState.list-scroll;
                    for row in BrowseState.mods: ModRowView {
                        item: row;
                    }
                }
            }
        }
    }

    if BrowseState.detail-open: ModDetailPage {
        width: parent.width;
        height: parent.height;
    }
}

component DownloadRowView inherits Rectangle {
    in property <DownloadRow> item;
    callback picked;
    height: layout.preferred-height;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: Theme.radius;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    layout := HorizontalLayout {
        padding: Theme.s1;
        padding-left: Theme.s2;
        spacing: Theme.s2;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.text-md;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.size;
                color: Theme.text-muted;
                font-size: Theme.text-sm;
            }
        }
        Button {
            y: (parent.height - self.height) / 2;
            text: "Install";
            clicked => { root.picked(); }
        }
    }
}

// Modal over the whole window: choose which of a mod's files to install.
export component DownloadPicker inherits Rectangle {
    background: Theme.bg-sunken.with-alpha(0.75);

    // Swallow clicks on the scrim.
    TouchArea { }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                BrowseState.cancel-pick();
                return accept;
            }
            reject
        }
    }

    init => { keys.focus(); }

    card := Rectangle {
        width: min(520px, root.width - 2 * Theme.s4);
        height: min(body.preferred-height, root.height - 2 * Theme.s4);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        // The card itself must not pass clicks to the scrim below.
        TouchArea { }

        body := VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;

            VerticalLayout {
                spacing: Theme.s1;
                Text {
                    text: BrowseState.picker-title;
                    color: Theme.text;
                    font-size: Theme.text-xl;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "This mod offers more than one file. Choose the one to install.";
                    color: Theme.text-muted;
                    font-size: Theme.text-md;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: min(BrowseState.picker-files.length * 56px, 280px);
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius;
                background: Theme.bg;
                clip: true;

                ListView {
                    for f[i] in BrowseState.picker-files: DownloadRowView {
                        item: f;
                        picked => { BrowseState.pick-download(i); }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { BrowseState.cancel-pick(); }
                }
            }
        }
    }
}
